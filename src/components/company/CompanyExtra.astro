---
/**
 * A company-specific section: hairline lists, photo features, or the
 * company's own contact details. Shape comes from data/company-pages.ts.
 */
import type { CompanyPageLabels, Extra } from '../../data/company-pages';
import SectionHeading from '../SectionHeading.astro';
import CtaLink from '../CtaLink.astro';
import Photo from '../Photo.astro';

interface Props {
  extra: Extra;
  labels: CompanyPageLabels;
  tone: 'plain' | 'alt';
}

const { extra, labels, tone } = Astro.props;
const titleId = `${extra.id}-title`;
const single = extra.kind === 'lists' && extra.lists.length === 1;
---

<section id={extra.id} class:list={['extra', extra.kind, tone]} aria-labelledby={titleId}>
  <div class="wrap">
    {extra.kind === 'lists' && (
      <div class:list={['lists-grid', { single }]}>
        <div class="reveal">
          <SectionHeading eyebrow={extra.eyebrow} title={extra.title} lede={extra.lede} id={titleId} />
        </div>
        <div class="lists">
          {extra.lists.map((list) => (
            <div class="list reveal">
              <h3>{list.title}</h3>
              <ul role="list">
                {list.items.map((item) => <li>{item}</li>)}
              </ul>
              {list.note && <p class="note">{list.note}</p>}
            </div>
          ))}
        </div>
      </div>
    )}

    {extra.kind === 'features' && (
      <>
        <div class="feat-head reveal">
          <SectionHeading eyebrow={extra.eyebrow} title={extra.title} lede={extra.lede} id={titleId} />
          {extra.action && (
            <CtaLink href={extra.action.href} external={extra.action.external}>{extra.action.label}</CtaLink>
          )}
        </div>
        <ul class:list={['feat-grid', { 'no-photos': !extra.items.some((i) => i.photo) }]} role="list">
          {extra.items.map((item) => (
            <li class="feat reveal">
              {item.photo && (
                <figure class="feat-photo">
                  <Photo photo={item.photo} sizes="(min-width: 64rem) 30vw, (min-width: 48rem) 50vw, 100vw" />
                </figure>
              )}
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </>
    )}

    {extra.kind === 'contact' && (
      <div class="contact-grid">
        <div class="reveal">
          <SectionHeading eyebrow={extra.eyebrow} title={extra.title} lede={extra.lede} id={titleId} />
        </div>
        <div class="reveal">
          <dl class="details">
            <div>
              <dt>{labels.address}</dt>
              <dd>{extra.address}</dd>
            </div>
            <div>
              <dt>{labels.telephone}</dt>
              <dd><a href={extra.phoneHref}><bdi dir="ltr">{extra.phone}</bdi></a></dd>
            </div>
            <div>
              <dt>{labels.email}</dt>
              <dd><a href={`mailto:${extra.email}`}>{extra.email}</a></dd>
            </div>
            {extra.website && (
              <div>
                <dt>{labels.website}</dt>
                <dd><a href={extra.website.href} target="_blank" rel="noopener noreferrer">{extra.website.label}</a></dd>
              </div>
            )}
          </dl>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .extra {
    padding-block: var(--section-space);
    border-top: 1px solid var(--color-rule);
  }

  .alt {
    background: var(--color-page-alt);
  }

  h3 {
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  :global(html[dir='rtl']) h3 {
    line-height: 1.45;
  }

  /* --- lists --- */
  .lists-grid {
    display: grid;
    gap: 3rem;
  }

  .lists {
    display: grid;
    gap: 2.5rem;
  }

  .list ul {
    margin-top: 1rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .list li {
    padding-block: 0.8rem;
    border-top: 1px solid var(--color-rule);
    font-size: 0.9375rem;
  }

  .note {
    margin-top: 1rem;
    font-size: var(--text-caption);
    color: var(--color-gold-ink);
  }

  @media (min-width: 48rem) {
    .lists {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      gap: 2.5rem 2rem;
    }

    /* A single list flows into two columns of rows. */
    .single .list ul {
      columns: 2;
      column-gap: 2rem;
      border-bottom: 0;
    }

    .single .list li {
      break-inside: avoid;
    }
  }

  @media (min-width: 64rem) {
    .lists-grid {
      grid-template-columns: 4fr 8fr;
      gap: 4rem;
      align-items: start;
    }
  }

  /* --- features --- */
  .feat-head {
    display: grid;
    justify-items: start;
    gap: 2rem;
  }

  .feat-grid {
    display: grid;
    gap: 2.5rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .feat {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .no-photos .feat {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule-strong);
  }

  .feat-photo {
    aspect-ratio: 16 / 10;
    margin-bottom: 0.75rem;
    overflow: hidden;
    background: var(--color-page-alt);
  }

  .feat p {
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  @media (min-width: 48rem) {
    .feat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .feat-head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .feat-grid:not(.no-photos) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* --- contact --- */
  .contact-grid {
    display: grid;
    gap: 2.5rem;
  }

  .details > div {
    display: grid;
    gap: 0.25rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--color-rule);
  }

  .details > div:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .details dt {
    font-size: var(--text-caption);
    color: var(--color-muted);
  }

  .details dd {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1.6vw, 1.3125rem);
    line-height: 1.4;
  }

  .details bdi {
    display: inline-block;
  }

  .details a {
    border-bottom: 1px solid var(--color-gold);
    transition: color 0.3s ease;
  }

  .details a:hover {
    color: var(--color-gold-ink);
  }

  @media (min-width: 64rem) {
    .contact-grid {
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
      align-items: start;
    }
  }
</style>
