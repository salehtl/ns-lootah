---
// The Group's other companies (logo, name and sector, each linking to its page),
// and a link to the full list. Open-ended: whatever is in the collection.
import { localizePath, useTranslations, type Locale } from "../../i18n";
import { getCompanies } from "../../lib/companies";
import { logo } from "../../lib/media";
import SectionHeading from "../SectionHeading.astro";
import CtaLink from "../CtaLink.astro";

interface Props {
  locale: Locale;
  /** The slug of the company whose page this is. */
  current: string;
}

const { locale, current } = Astro.props;
const copy = useTranslations(locale).companies.page;
const others = (await getCompanies(locale))
  .filter((c) => c.slug !== current)
  .map((c) => ({ ...c, mark: logo(c.data.logo) }));
---

<section class="more" aria-labelledby="more-title">
  <div class="wrap">
    <div class="more-head" data-enter>
      <SectionHeading id="more-title" label={copy.moreLabel} title={copy.moreTitle} />
      <CtaLink href={localizePath(locale, "/companies/")} variant="text">{copy.allCompanies}</CtaLink>
    </div>
    <ul class="more-grid" role="list">
      {
        others.map((c, i) => (
          <li data-enter style={`--i: ${i % 3}`}>
            <a href={c.href}>
              <img src={c.mark.src} width={c.mark.width} height={c.mark.height} alt="" loading="lazy" />
              <span class="m-name">{c.data.name}</span>
              <span class="m-sector">{c.data.sector}</span>
              <svg class="m-arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .more {
    padding-block: var(--section-space);
    border-top: var(--border-hairline);
  }
  .more-head {
    display: grid;
    justify-items: start;
    gap: 2rem;
  }
  .more-grid {
    display: grid;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: var(--border-hairline);
  }
  .more-grid li {
    border-bottom: var(--border-hairline);
  }
  .more-grid a {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-items: center;
    gap: 0.15rem 1.5rem;
    height: 100%;
    padding-block: 1.5rem;
    padding-inline-end: 2.5rem;
  }
  .more-grid img {
    grid-row: span 2;
    width: 100%;
    height: 2.75rem;
    object-fit: contain;
    object-position: left center;
  }
  :global(html[dir="rtl"]) .more-grid img {
    object-position: right center;
  }
  .m-name {
    align-self: end;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    line-height: 1.3;
    transition: color var(--transition-colour);
  }
  :global(html[dir="rtl"]) .m-name {
    line-height: 1.5;
  }
  .m-sector {
    align-self: start;
    font-size: var(--text-caption);
    color: var(--color-muted);
  }
  .m-arrow {
    position: absolute;
    inset-inline-end: 0.5rem;
    top: 50%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    color: var(--color-gold-ink);
    transform: translateY(-50%) scaleX(var(--dir));
    transition: transform var(--transition-nudge);
  }
  @media (hover: hover) and (pointer: fine) {
    .more-grid a:hover .m-name {
      color: var(--color-gold-ink);
    }
    .more-grid a:hover .m-arrow {
      transform: translate(calc(3px * var(--dir)), -50%) scaleX(var(--dir));
    }
  }
  @media (min-width: 48rem) {
    .more-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
  @media (min-width: 64rem) {
    .more-head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
  @media (min-width: 72rem) {
    .more-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
