---
/** Careers: why join, culture and values, where you could work, how to apply. */
import type { Lang } from '../../i18n/types';
import { t } from '../../i18n/translations';
import { getLocalizedPath } from '../../i18n/utils';
import { group } from '../../data/group';
import { careers } from '../../data/pages/careers';
import PageHero from '../PageHero.astro';
import SectionHeading from '../SectionHeading.astro';
import Photo from '../Photo.astro';
import CtaLink from '../CtaLink.astro';
import CompanyIndex from '../about/CompanyIndex.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const strings = t(lang);
const copy = careers[lang];
const g = group[lang];
const mailto = `mailto:${copy.apply.email}?subject=${encodeURIComponent(copy.apply.subject)}`;
---

<PageHero
  variant="wash"
  image={g.imagery.tower}
  eyebrow={copy.hero.eyebrow}
  title={copy.hero.title}
  lede={copy.hero.lede}
  crumbs={[{ label: strings.nav.home, href: getLocalizedPath('/', lang) }, { label: strings.nav.careers }]}
  crumbsLabel={lang === 'ar' ? 'مسار التنقل' : 'Breadcrumb'}
>
  <CtaLink href="#apply" variant="solid">{copy.hero.primaryCta}</CtaLink>
  <CtaLink href="#why" variant="text">{copy.hero.secondaryCta}</CtaLink>
</PageHero>

<!-- Why join -->
<section class="why" id="why" aria-labelledby="careers-why">
  <div class="wrap why-grid">
    <div class="reveal">
      <SectionHeading id="careers-why" eyebrow={copy.why.eyebrow} title={copy.why.title} lede={copy.why.lede} />
    </div>
    <ol class="benefits" role="list">
      {copy.why.benefits.map((b, i) => (
        <li class="reveal">
          <span class="b-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="b-text">{b}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Culture -->
<section class="culture" aria-labelledby="careers-culture">
  <div class="wrap culture-grid">
    <figure class="culture-photo reveal">
      <Photo photo={copy.culture.photo} sizes="(min-width: 64rem) 45vw, 100vw" />
    </figure>
    <div class="culture-copy">
      <div class="reveal">
        <SectionHeading id="careers-culture" eyebrow={copy.culture.eyebrow} title={copy.culture.title} />
      </div>
      <p class="culture-text reveal">{copy.culture.text}</p>
      <ul class="value-tags reveal" role="list">
        {g.values.items.map((v) => <li>{v.name}</li>)}
      </ul>
      <div class="reveal">
        <CtaLink href={`${getLocalizedPath('/about', lang)}#values`} variant="text">{copy.culture.valuesCta}</CtaLink>
      </div>
    </div>
  </div>
</section>

<!-- Companies -->
<section class="where" aria-labelledby="careers-where">
  <div class="wrap">
    <div class="where-head reveal">
      <SectionHeading id="careers-where" eyebrow={copy.companies.eyebrow} title={copy.companies.title} />
    </div>
    <CompanyIndex lang={lang} variant="compact" />
  </div>
</section>

<!-- Apply -->
<section class="apply" id="apply" aria-labelledby="careers-apply">
  <div class="wrap">
    <div class="apply-grid">
      <div class="reveal">
        <SectionHeading id="careers-apply" eyebrow={copy.apply.eyebrow} title={copy.apply.title} />
      </div>
      <div class="apply-copy reveal">
        <p>{copy.apply.text}</p>
        <div class="apply-actions">
          <CtaLink href={mailto} variant="solid">{copy.apply.cta}</CtaLink>
          <a class="apply-email" href={mailto}>
            <span class="visually-hidden">{copy.apply.emailLabel}: </span>{copy.apply.email}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding-block: var(--section-space);
  }

  /* --- Why --- */
  .why-grid {
    display: grid;
    gap: 3rem;
  }

  .benefits {
    border-top: 1px solid var(--color-rule-strong);
  }

  .benefits li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .b-num {
    font-size: var(--text-caption);
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  .b-text {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.3;
  }

  :global(html[dir='rtl']) .b-text {
    line-height: 1.6;
  }

  @media (min-width: 64rem) {
    .why-grid {
      grid-template-columns: 5fr 6fr;
      gap: 6rem;
      align-items: start;
    }
  }

  /* --- Culture --- */
  .culture {
    border-top: 1px solid var(--color-rule);
    background: var(--color-page-alt);
  }

  .culture-grid {
    display: grid;
    gap: 3rem;
  }

  .culture-photo {
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .culture-copy {
    display: grid;
    gap: 1.5rem;
    align-content: center;
  }

  .culture-text {
    font-size: var(--text-lede);
    color: var(--color-muted);
  }

  .value-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .value-tags li {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    background: var(--color-page);
    font-size: var(--text-small);
  }

  @media (min-width: 64rem) {
    .culture-grid {
      grid-template-columns: 6fr 5fr;
      gap: 5rem;
    }

    .culture-photo {
      aspect-ratio: 4 / 3;
    }
  }

  /* --- Where --- */
  .where-head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* --- Apply --- */
  .apply {
    border-top: 1px solid var(--color-rule);
  }

  .apply-grid {
    display: grid;
    gap: 2rem;
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-rule-strong);
  }

  .apply-copy {
    display: grid;
    gap: 2rem;
    align-content: start;
    font-size: var(--text-lede);
    color: var(--color-muted);
  }

  .apply-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .apply-email {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  .apply-email:hover {
    color: var(--color-gold-ink);
  }

  @media (min-width: 64rem) {
    .apply-grid {
      grid-template-columns: 6fr 5fr;
      gap: 6rem;
    }
  }
</style>
