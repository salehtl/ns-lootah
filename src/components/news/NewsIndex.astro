---
/** News index: the articles as large editorial cards, newest first. */
import type { Lang } from '../../i18n/types';
import { t } from '../../i18n/translations';
import { getLocalizedPath } from '../../i18n/utils';
import { news } from '../../data/pages/news';
import PageHero from '../PageHero.astro';
import Photo from '../Photo.astro';
import ContactBand from '../ContactBand.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const strings = t(lang);
const copy = news[lang];
---

<PageHero
  eyebrow={copy.hero.eyebrow}
  title={copy.hero.title}
  lede={copy.hero.lede}
  crumbs={[{ label: strings.nav.home, href: getLocalizedPath('/', lang) }, { label: strings.nav.news }]}
  crumbsLabel={lang === 'ar' ? 'مسار التنقل' : 'Breadcrumb'}
/>

<section class="list" aria-labelledby="news-latest">
  <div class="wrap">
    <h2 id="news-latest" class="eyebrow list-label">{copy.listLabel}</h2>
    <ol class="articles" role="list">
      {copy.articles.map((a) => (
        <li class="reveal">
          <article class="card">
            <div class="card-media">
              <Photo photo={a.card} sizes="(min-width: 64rem) 36rem, 100vw" />
            </div>
            <div class="card-body">
              <p class="eyebrow">{a.topic}</p>
              <h3 class="card-title">
                <a href={getLocalizedPath(`/news/${a.slug}`, lang)}>{a.title}</a>
              </h3>
              <p class="card-summary">{a.summary}</p>
              <span class="card-more" aria-hidden="true">
                {copy.readMore}
                <svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
              </span>
            </div>
          </article>
        </li>
      ))}
    </ol>
    <p class="soon">{copy.comingSoon}</p>
  </div>
</section>

<ContactBand lang={lang} />

<style>
  .list {
    padding-block: clamp(3rem, 7vw, 5.5rem) var(--section-space);
  }

  .list-label {
    margin-bottom: 1.5rem;
  }

  .articles {
    border-top: 1px solid var(--color-rule-strong);
  }

  .articles > li {
    padding-block: 2rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .card {
    position: relative;
    display: grid;
    gap: 1.75rem;
  }

  .card-media {
    aspect-ratio: 600 / 537;
    max-width: 36rem;
    overflow: hidden;
  }

  .card-media :global(.photo) {
    filter: grayscale(0.2);
    transition: transform 0.6s var(--ease-out);
  }

  .card-body {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: 1rem;
  }

  .card-title {
    font-size: var(--text-h3);
    line-height: 1.15;
  }

  /* Stretched link: the title's anchor makes the whole card clickable. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-title a:focus-visible {
    outline: none;
  }

  .card:has(.card-title a:focus-visible) {
    outline: 2px solid var(--color-gold-ink);
    outline-offset: 6px;
  }

  .card-summary {
    color: var(--color-muted);
  }

  .card-more {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-gold);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    transition: color 0.3s ease;
  }

  .card-more svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    transform: scaleX(var(--dir));
    transition: transform 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover .card-title,
    .card:hover .card-more {
      color: var(--color-gold-ink);
    }

    .card:hover .card-more svg {
      transform: translateX(calc(3px * var(--dir))) scaleX(var(--dir));
    }

    .card:hover .card-media :global(.photo) {
      transform: scale(1.03);
    }
  }

  @media (min-width: 64rem) {
    .card {
      grid-template-columns: 5fr 6fr;
      gap: 4rem;
      align-items: center;
    }
  }

  .soon {
    margin-top: 2rem;
    font-size: var(--text-small);
    color: var(--color-muted);
  }
</style>
