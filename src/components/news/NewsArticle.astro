---
/** A news article: long-form measure, pull quotes, the press photograph alongside. */
import type { Lang } from '../../i18n/types';
import { t } from '../../i18n/translations';
import { getLocalizedPath } from '../../i18n/utils';
import { news, getArticle } from '../../data/pages/news';
import PageHero from '../PageHero.astro';
import Photo from '../Photo.astro';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const strings = t(lang);
const copy = news[lang];
const article = getArticle(lang, slug);
const newsHref = getLocalizedPath('/news', lang);
---

<article class="article" aria-labelledby="page-title">
  <PageHero
    eyebrow={article.topic}
    title={{ lead: article.title, accent: '' }}
    lede={article.summary}
    crumbs={[
      { label: strings.nav.home, href: getLocalizedPath('/', lang) },
      { label: strings.nav.news, href: newsHref },
      { label: article.title },
    ]}
    crumbsLabel={lang === 'ar' ? 'مسار التنقل' : 'Breadcrumb'}
  />

  <div class="wrap article-grid">
    <figure class="article-photo">
      <div class="photo-box">
        <Photo photo={article.photo} sizes="(min-width: 64rem) 22rem, 90vw" />
      </div>
      <figcaption>{article.caption}</figcaption>
    </figure>

    <div class="article-body">
      {article.blocks.map((block) =>
        block.type === 'p' ? (
          <p>{block.text}</p>
        ) : (
          <figure class="quote">
            <blockquote>
              <p>{block.text}</p>
            </blockquote>
            <figcaption>{block.author}</figcaption>
          </figure>
        ),
      )}

      <a class="back" href={newsHref}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4" /></svg>
        {copy.backToNews}
      </a>
    </div>
  </div>
</article>

<style>
  .article-grid {
    display: grid;
    gap: 3rem;
    padding-block: clamp(3rem, 7vw, 5rem) var(--section-space);
  }

  .article-photo {
    max-width: 22rem;
  }

  .photo-box {
    aspect-ratio: 600 / 798;
    overflow: hidden;
  }

  .article-photo figcaption {
    margin-top: 0.75rem;
    font-size: var(--text-caption);
    color: var(--color-muted);
  }

  .article-body {
    display: grid;
    gap: 1.5rem;
    max-width: 65ch;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  :global(html[dir='rtl']) .article-body {
    font-size: 1.125rem;
    line-height: 1.95;
  }

  .article-body > p:first-child::first-line {
    color: var(--color-ink);
  }

  .quote {
    margin-block: 1.5rem;
    padding-inline-start: 1.5rem;
    border-inline-start: 2px solid var(--color-gold);
  }

  .quote blockquote p {
    font-family: var(--font-display);
    font-style: var(--style-accent);
    font-size: clamp(1.3125rem, 2vw, 1.625rem);
    line-height: 1.45;
    color: var(--color-ink);
  }

  :global(html[dir='rtl']) .quote blockquote p {
    line-height: 1.75;
  }

  .quote figcaption {
    margin-top: 1rem;
    font-size: var(--text-small);
    color: var(--color-gold-ink);
  }

  .back {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.6rem;
    margin-top: 2rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-gold);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    transition: color 0.3s ease;
  }

  :global(html[dir='rtl']) .back {
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .back svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    transform: scaleX(var(--dir));
    transition: transform 0.3s ease;
  }

  .back:hover {
    color: var(--color-gold-ink);
  }

  .back:hover svg {
    transform: translateX(calc(-3px * var(--dir))) scaleX(var(--dir));
  }

  @media (min-width: 64rem) {
    .article-grid {
      grid-template-columns: 22rem minmax(0, 1fr);
      gap: 6rem;
      align-items: start;
    }

    .article-photo {
      position: sticky;
      top: calc(var(--header-height) + 2rem);
    }
  }
</style>
