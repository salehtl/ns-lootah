---
// Black site footer: the Group's mark, its companies, Group links, contact,
// the legal line and the language switch.
import { locales, localizePath, useTranslations, type Locale } from "../i18n";
import { getCompanies } from "../lib/companies";
import { logo } from "../lib/media";
import { telHref } from "../lib/links";

interface Props {
  locale: Locale;
  /** This page in the other languages, each linked by its own name ("العربية", "English"). */
  translations: { code: Locale; href: URL }[];
}

const { locale, translations } = Astro.props;
const t = useTranslations(locale);
const companies = await getCompanies(locale);
const mark = logo("ns-lootah-group-horizontal-white");
const year = new Date().getFullYear();
const groupLinks = [
  { label: t.footer.aboutGroup, href: localizePath(locale, "/about/") },
  { label: t.nav.news, href: localizePath(locale, "/news/") },
  { label: t.nav.careers, href: localizePath(locale, "/careers/") },
  { label: t.nav.contact, href: localizePath(locale, "/contact/") },
];
---

<footer class="ftr">
  <div class="wrap ftr-top">
    <div class="ftr-brand">
      <a href={localizePath(locale)} aria-label={t.nav.home}>
        <img src={mark.src} width={mark.width} height={mark.height} alt="" loading="lazy" />
      </a>
      <p>{t.footer.tagline}</p>
    </div>

    <nav class="ftr-nav" aria-label={t.footer.label}>
      <div>
        <h2 class="ftr-h">{t.footer.companies}</h2>
        <ul role="list">
          {companies.map((c) => <li><a href={c.href}>{c.data.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="ftr-h">{t.footer.group}</h2>
        <ul role="list">
          {groupLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
    </nav>

    <div class="ftr-contact">
      <h2 class="ftr-h">{t.footer.contact}</h2>
      <address>
        <p>{t.firm.address}</p>
        <p><a href={telHref(t.firm.phone)}><bdi dir="ltr">{t.firm.phone}</bdi></a></p>
        <p><a href={`mailto:${t.firm.email}`}>{t.firm.email}</a></p>
      </address>
    </div>
  </div>

  <div class="wrap ftr-bottom">
    <p>© {year} {t.firm.legalName}. {t.footer.rights}</p>
    {
      translations.map(({ code, href }) => (
        <a class="lang" href={href.pathname} lang={code} hreflang={code}>
          {locales[code].name}
        </a>
      ))
    }
  </div>
</footer>

<style>
  .ftr {
    padding-block: clamp(3.5rem, 7vw, 5rem) 2rem;
    background: var(--color-black);
    color: var(--color-on-dark);
    font-size: var(--text-small);
  }
  .ftr-top {
    display: grid;
    gap: 3rem;
  }
  .ftr-brand {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .ftr-brand img {
    width: auto;
    height: 2.75rem;
  }
  .ftr-brand p {
    max-width: 32ch;
    color: var(--color-on-dark-muted);
  }
  .ftr-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }
  .ftr-h {
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: var(--font-weight-medium);
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold-glow);
  }
  :global(html[dir="rtl"]) .ftr-h {
    font-size: var(--text-small);
    font-weight: var(--font-weight-bold);
    text-transform: none;
  }
  .ftr ul {
    display: grid;
    gap: 0.6rem;
  }
  .ftr a {
    color: var(--color-on-dark-muted);
  }
  .ftr a:hover {
    color: var(--color-on-dark);
  }
  .ftr address {
    display: grid;
    gap: 0.6rem;
    font-style: normal;
    color: var(--color-on-dark-muted);
  }
  .ftr :focus-visible {
    outline-color: var(--color-gold-glow);
  }
  .ftr-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    /* A hairline across the content column only, not the gutters. */
    background: linear-gradient(var(--color-rule-dark), var(--color-rule-dark)) top center / calc(100% - 2 * var(--gutter)) 1px no-repeat;
    font-size: var(--text-caption);
    color: var(--color-on-dark-muted);
  }
  .ftr-bottom p {
    max-width: none;
  }
  .lang:lang(ar) {
    font-family: var(--font-arabic);
    font-size: 0.9375rem;
  }
  .lang:lang(en) {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }
  @media (min-width: 64rem) {
    .ftr-top {
      grid-template-columns: 1.1fr 1.6fr 1fr;
      gap: 4rem;
    }
  }
</style>
