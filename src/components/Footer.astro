---
/** Black site footer: brand, the six companies, Group links, contact, legal. */
import type { Lang } from '../i18n/types';
import { t } from '../i18n/translations';
import { getLocalizedPath } from '../i18n/utils';
import { companies } from '../data/companies';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const strings = t(lang);
const year = new Date().getFullYear();

const groupLinks = [
  { label: strings.nav.aboutGroup, href: getLocalizedPath('/about', lang) },
  { label: strings.nav.news, href: getLocalizedPath('/news', lang) },
  { label: strings.nav.careers, href: getLocalizedPath('/careers', lang) },
  { label: strings.nav.contact, href: getLocalizedPath('/contact', lang) },
];
---

<footer class="ftr" transition:name="site-footer" transition:animate="none">
  <div class="wrap ftr-top">
    <div class="ftr-brand">
      <a href={getLocalizedPath('/', lang)} aria-label={`${strings.site.name} — ${strings.nav.home}`}>
        <img src="/images/logos/ns-lootah-group-horizontal-white.svg" width="317" height="100" alt="" loading="lazy" />
      </a>
      <p>{strings.footer.tagline}</p>
    </div>

    <nav class="ftr-nav" aria-label={strings.nav.footerNavigation}>
      <div>
        <h2 class="ftr-h">{strings.footer.companies}</h2>
        <ul role="list">
          {companies[lang].map((c) => <li><a href={getLocalizedPath(c.path, lang)}>{c.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="ftr-h">{strings.footer.group}</h2>
        <ul role="list">
          {groupLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
    </nav>

    <div class="ftr-contact">
      <h2 class="ftr-h">{strings.footer.contact}</h2>
      <address>
        <p>{strings.site.address}</p>
        <p><a href={strings.site.phoneHref}><bdi dir="ltr">{strings.site.phone}</bdi></a></p>
        <p><a href={`mailto:${strings.site.email}`}>{strings.site.email}</a></p>
      </address>
    </div>
  </div>

  <div class="wrap ftr-bottom">
    <p>© {year} {strings.site.legalName}. {strings.footer.rights}</p>
    <LanguageSwitcher lang={lang} currentPath={currentPath} />
  </div>
</footer>

<style>
  .ftr {
    padding-block: clamp(3.5rem, 7vw, 5rem) 2rem;
    background: var(--color-black);
    color: var(--color-on-dark);
    font-size: var(--text-small);
  }

  .ftr-top {
    display: grid;
    gap: 3rem;
  }

  .ftr-brand {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .ftr-brand img {
    width: auto;
    height: 2.75rem;
  }

  .ftr-brand p {
    max-width: 32ch;
    color: var(--color-on-dark-muted);
  }

  .ftr-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .ftr-h {
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold-glow);
  }

  :global(html[dir='rtl']) .ftr-h {
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: none;
  }

  .ftr ul {
    display: grid;
    gap: 0.6rem;
  }

  .ftr a {
    color: var(--color-on-dark-muted);
    transition: color 0.3s ease;
  }

  .ftr a:hover {
    color: var(--color-on-dark);
  }

  .ftr-bottom :global(.lang-switcher) {
    color: var(--color-on-dark-muted);
  }

  .ftr-bottom :global(.lang-switcher:hover) {
    color: var(--color-on-dark);
  }

  .ftr address {
    display: grid;
    gap: 0.6rem;
    font-style: normal;
    color: var(--color-on-dark-muted);
  }

  .ftr :focus-visible {
    outline-color: var(--color-gold-glow);
  }

  .ftr-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    /* A hairline across the content column only, not the gutters. */
    background: linear-gradient(var(--color-rule-dark), var(--color-rule-dark)) top center / calc(100% - 2 * var(--gutter)) 1px no-repeat;
    font-size: var(--text-caption);
    color: var(--color-on-dark-muted);
  }

  .ftr-bottom p {
    max-width: none;
  }

  @media (min-width: 64rem) {
    .ftr-top {
      grid-template-columns: 1.1fr 1.6fr 1fr;
      gap: 4rem;
    }
  }
</style>
