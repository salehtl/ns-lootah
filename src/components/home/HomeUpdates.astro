---
/** Two doors out of the homepage: the latest news story and careers. */
import type { Lang } from '../../i18n/types';
import { getLocalizedPath } from '../../i18n/utils';
import { home } from '../../data/home';
import Photo from '../Photo.astro';
import CtaLink from '../CtaLink.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = home[lang].updates;
const cards = [copy.news, copy.careers];
---

<section class="updates" aria-labelledby="home-updates-title">
  <div class="wrap">
    <h2 id="home-updates-title" class="eyebrow">{copy.heading}</h2>
    <div class="cards">
      {cards.map((c) => (
        <article class="card reveal">
          <div class="card-img">
            <Photo photo={c.photo} sizes="(min-width: 64rem) 40vw, 100vw" />
          </div>
          <p class="eyebrow">{c.eyebrow}</p>
          <h3 class="card-title">{c.title}</h3>
          <p class="card-text">{c.text}</p>
          <CtaLink href={getLocalizedPath(c.path, lang)} variant="text">{c.cta}</CtaLink>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .updates {
    padding-block: var(--section-space);
    border-top: 1px solid var(--color-rule);
  }

  .cards {
    display: grid;
    gap: 4rem 3rem;
    margin-top: 2.5rem;
  }

  .card {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: 1rem;
  }

  .card-img {
    width: 100%;
    aspect-ratio: 3 / 2;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }

  .card-img :global(.photo) {
    transition: transform 0.6s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover .card-img :global(.photo) {
      transform: scale(1.03);
    }
  }

  .card-title {
    font-size: var(--text-h3);
  }

  .card-text {
    max-width: 44ch;
    margin-bottom: 0.5rem;
    color: var(--color-muted);
  }

  @media (min-width: 64rem) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
