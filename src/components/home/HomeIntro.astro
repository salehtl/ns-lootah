---
// The Group in one statement. Where scroll-driven animations are supported,
// its words brighten as it crosses the screen.
import { useTranslations, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { statement } = t.about;
const lead = statement.lead.split(" ");
const accent = statement.accent.split(" ");
---

<section class="intro" id="home-intro" aria-labelledby="home-intro-title">
  <div class="wrap">
    <h2 id="home-intro-title" class="eyebrow">{t.home.intro.label}</h2>
    <p class="statement">
      {lead.map((w) => <span class="w">{w} </span>)}
      {accent.map((w) => <span class="w g">{w} </span>)}
    </p>
  </div>
</section>

<style>
  .intro {
    padding-block: clamp(5rem, 12vw, 10rem);
  }
  .statement {
    max-width: 30ch;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.6vw, 3.25rem);
    line-height: 1.22;
    letter-spacing: -0.01em;
  }
  :global(html[dir="rtl"]) .statement {
    max-width: 34ch;
    font-size: clamp(1.625rem, 3.2vw, 2.75rem);
    line-height: 1.55;
  }
  .statement .g {
    font-style: var(--style-accent);
    color: var(--color-gold);
  }
  /* Longhands only: the minifier breaks the shorthand with a timeline. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .statement .w {
        opacity: 0.22;
        animation-name: word-on;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 18% cover 34%;
      }
    }
  }
  @keyframes word-on {
    to {
      opacity: 1;
    }
  }
</style>
