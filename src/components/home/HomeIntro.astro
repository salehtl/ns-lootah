---
/** The Group in one statement — words light up as it scrolls through — and four figures. */
import type { Lang } from '../../i18n/types';
import { home } from '../../data/home';
import { group } from '../../data/group';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { statement, stats } = group[lang];
const lead = statement.lead.split(' ');
const accent = statement.accent.split(' ');
---

<section class="intro" id="home-intro" aria-labelledby="home-intro-title">
  <div class="wrap">
    <h2 id="home-intro-title" class="eyebrow">{home[lang].intro.eyebrow}</h2>
    <p class="statement">
      {lead.map((w) => <span class="w">{w} </span>)}
      {accent.map((w) => <span class="w g">{w} </span>)}
    </p>
    <dl class="stats">
      {stats.map((s) => <div class="reveal"><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
    </dl>
  </div>
</section>

<style>
  .intro {
    padding-block: clamp(5rem, 12vw, 10rem);
  }

  .statement {
    max-width: 30ch;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.6vw, 3.25rem);
    line-height: 1.22;
    letter-spacing: -0.01em;
  }

  :global(html[dir='rtl']) .statement {
    max-width: 34ch;
    font-size: clamp(1.625rem, 3.2vw, 2.75rem);
    line-height: 1.55;
  }

  .statement .g {
    font-style: var(--style-accent);
    color: var(--color-gold);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 2rem;
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-rule);
  }

  .stats dt {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  :global(html[dir='rtl']) .stats dt {
    font-size: var(--text-small);
  }

  .stats dd {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    line-height: 1.1;
    color: var(--color-gold);
  }

  @media (min-width: 64rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Words brighten as the statement crosses the viewport. Longhands only. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .statement .w {
        opacity: 0.22;
        animation-name: word-on;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 18% cover 34%;
      }
    }
  }

  @keyframes word-on {
    to {
      opacity: 1;
    }
  }
</style>
