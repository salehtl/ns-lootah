---
// Home cover: the towers as a pale print, the monogram and the Group's line,
// "Diversified businesses. One standard."
import { useTranslations, type Locale } from "../../i18n";
import { logo, photo } from "../../lib/media";
import Photo from "../Photo.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const hero = useTranslations(locale).home.hero;
const mark = logo("ns-lootah-group-bronze");
---

<section class="hero" aria-labelledby="home-title">
  <div class="hero-bg">
    <Photo src={photo(hero.photo)} sizes="100vw" priority />
  </div>
  <div class="wrap hero-in">
    <img class="hero-mark" src={mark.src} width={mark.width} height={mark.height} alt={hero.markAlt} fetchpriority="high" />
    <div>
      <h1 id="home-title" class="hero-title">
        <span class="l"><span>{hero.lead}</span></span>
        <span class="l"><span class="gi">{hero.accent}</span></span>
      </h1>
      <p class="hero-sub">{hero.intro}</p>
    </div>
  </div>
  <a class="cue" href="#home-intro">
    <span>{hero.cue}</span>
    <span class="cue-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--header-height) + 3rem) 7rem;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero-bg :global(.photo-img) {
    filter: grayscale(1);
  }
  /* A page-coloured wash: a pale architectural print, light enough for black type. */
  .hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at calc(50% - 20% * var(--dir)) 50%, rgb(245 245 244 / 0.6), transparent 70%),
      linear-gradient(to bottom, transparent 55%, var(--color-bg)),
      linear-gradient(var(--color-wash), var(--color-wash));
  }
  .hero-in {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .hero-mark {
    width: clamp(7.5rem, 18vw, 15rem);
    height: auto;
  }
  .hero-title {
    font-size: var(--text-hero);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }
  :global(html[dir="rtl"]) .hero-title {
    line-height: 1.25;
  }
  .hero-title .l {
    display: block;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .hero-title .l > span {
    display: inline-block;
  }
  .hero-sub {
    max-width: 36rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: var(--border-hairline);
    font-size: 1.0625rem;
    color: var(--color-muted);
  }
  @media (min-width: 64rem) {
    .hero-in {
      grid-template-columns: auto 1fr;
      gap: clamp(3rem, 7vw, 7rem);
    }
  }
  .cue {
    position: absolute;
    bottom: 2rem;
    inset-inline-start: var(--gutter);
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-muted);
    font-size: var(--text-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  :global(html[dir="rtl"]) .cue {
    font-size: var(--text-small);
  }
  .cue:hover {
    color: var(--color-ink);
  }
  .cue-line {
    position: relative;
    width: 4rem;
    height: 1px;
    overflow: hidden;
    background: var(--color-rule);
    /* Sweeps in the reading direction. */
    transform: scaleX(var(--dir));
  }
  .cue-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-gold-ink);
    transform: scaleX(0);
    transform-origin: left;
  }
  @media (min-width: 80rem) {
    .cue {
      inset-inline-start: calc((100% - var(--container-page)) / 2 + var(--gutter));
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-bg {
      animation: hero-settle 1.6s var(--ease-out) both;
    }
    .hero-mark {
      animation: hero-mark 1s var(--ease-out) 0.1s both;
    }
    .hero-title .l > span {
      animation: hero-rise 0.9s var(--ease-out) 0.25s both;
    }
    .hero-title .l:nth-child(2) > span {
      animation-delay: 0.33s;
    }
    .hero-sub {
      animation: hero-fade 0.8s var(--ease-out) 0.55s both;
    }
    .cue {
      animation: hero-fade 0.8s var(--ease-out) 0.8s both;
    }
    .cue-line::after {
      animation: hero-sweep 2.4s var(--ease-in-out) 1.4s infinite;
    }
  }
  @keyframes hero-settle {
    from {
      opacity: 0;
      transform: scale(1.08);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-mark {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-rise {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-sweep {
    0% {
      transform: scaleX(0);
      transform-origin: left;
    }
    45% {
      transform: scaleX(1);
      transform-origin: left;
    }
    55% {
      transform: scaleX(1);
      transform-origin: right;
    }
    100% {
      transform: scaleX(0);
      transform-origin: right;
    }
  }
</style>
