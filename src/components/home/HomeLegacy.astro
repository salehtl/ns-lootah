---
// Legacy and leadership: the story in brief and the Chairman's portrait.
import { localizePath, useTranslations, type Locale } from "../../i18n";
import { photo } from "../../lib/media";
import SectionHeading from "../SectionHeading.astro";
import CtaLink from "../CtaLink.astro";
import Photo from "../Photo.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { legacy, chairman } = t.about;
---

<section class="legacy" aria-labelledby="home-legacy-title">
  <div class="wrap legacy-grid">
    <div class="legacy-copy" data-enter>
      <SectionHeading id="home-legacy-title" label={legacy.label} title={legacy.title} />
      <p>{legacy.intro} {legacy.founder}</p>
      <p>{legacy.today}</p>
      <div class="legacy-more">
        <CtaLink href={localizePath(locale, "/about/")} variant="text">{t.home.legacy.more}</CtaLink>
      </div>
    </div>
    <figure class="portrait" data-enter style="--i: 1">
      <div class="portrait-img">
        <Photo src={photo(chairman.portrait)} alt={chairman.portraitAlt} sizes="(min-width: 64rem) 22rem, 90vw" />
      </div>
      <figcaption>
        <span class="p-name">{chairman.name}</span>
        <span class="p-role">{chairman.role}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .legacy {
    padding-block: var(--section-space);
    border-top: var(--border-hairline);
    background: var(--color-surface);
  }
  .legacy-grid {
    display: grid;
    gap: 3rem;
  }
  .legacy-copy > p {
    max-width: 58ch;
    margin-top: 1.25rem;
    color: var(--color-muted);
  }
  .legacy-copy > p:first-of-type {
    margin-top: 2rem;
  }
  .legacy-more {
    margin-top: 2rem;
  }
  .portrait {
    max-width: 22rem;
  }
  .portrait-img {
    aspect-ratio: 536 / 800;
    overflow: hidden;
    border-radius: 0.75rem;
  }
  .portrait-img :global(.photo-img) {
    filter: grayscale(0.15);
  }
  .portrait figcaption {
    display: grid;
    gap: 0.25rem;
    margin-top: 1rem;
  }
  .p-name {
    font-family: var(--font-display);
    font-style: var(--style-accent);
    font-size: 1.125rem;
  }
  .p-role {
    font-size: var(--text-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold-ink);
  }
  :global(html[dir="rtl"]) .p-role {
    font-size: var(--text-small);
  }
  @media (min-width: 64rem) {
    .legacy-grid {
      grid-template-columns: 1fr auto;
      gap: 6rem;
      align-items: end;
    }
  }
</style>
