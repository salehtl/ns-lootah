---
// One full-screen chapter per company: a text column and a full-height photo
// panel that unveils on scroll. On wide screens a fixed index tracks the
// chapter in view (a small script, a progressive enhancement). The list is
// open-ended: it shows whatever is in src/content/companies/, in order.
import { useTranslations, type Locale } from "../../i18n";
import { getCompanies } from "../../lib/companies";
import { logo, photo } from "../../lib/media";
import Photo from "../Photo.astro";
import CtaLink from "../CtaLink.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = useTranslations(locale).home.companies;
const companies = (await getCompanies(locale)).map((c) => ({ ...c, mark: logo(c.data.logo), cover: photo(c.data.cover) }));
---

<div class="chapters" id="companies" data-chapters>
  <h2 class="visually-hidden">{copy.heading}</h2>
  <nav class="index" aria-label={copy.indexLabel} data-chapter-index>
    <ol role="list">
      {
        companies.map((c) => (
          <li>
            <a href={`#company-${c.slug}`} data-chapter-link={c.slug}>
              <span class="ix-num">{c.number}</span>
              <span class="ix-name">{c.data.shortName}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  {
    companies.map((c) => (
      <section class="chapter" id={`company-${c.slug}`} data-chapter={c.slug} aria-labelledby={`company-${c.slug}-title`}>
        <figure class="chapter-media">
          <Photo src={c.cover} alt={c.data.coverAlt} sizes="(min-width: 64rem) 54vw, 100vw" reveal={false} />
        </figure>
        <div class="wrap chapter-in">
          <div class="chapter-body">
            <p class="chapter-meta">
              <span>{c.number}</span>
              <span>{c.data.sector}</span>
            </p>
            <img class="chapter-logo" src={c.mark.src} width={c.mark.width} height={c.mark.height} alt="" loading="lazy" />
            <h3 id={`company-${c.slug}-title`} class="chapter-title">
              {c.data.name}
            </h3>
            <p class="chapter-tag">{c.data.tagline}</p>
            <p class="chapter-text">{c.data.summary}</p>
            <ul class="chapter-points" role="list">
              {c.data.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            <div class="chapter-cta">
              <CtaLink href={c.href}>{c.data.cta}</CtaLink>
            </div>
          </div>
        </div>
      </section>
    ))
  }
</div>

<script>
  // Marks the chapter crossing the middle of the screen in the index, and shows
  // the index only while a chapter is on screen.
  const root = document.querySelector<HTMLElement>("[data-chapters]");
  if (root && "IntersectionObserver" in window) {
    const index = root.querySelector<HTMLElement>("[data-chapter-index]");
    const links = new Map(
      Array.from(root.querySelectorAll<HTMLAnchorElement>("[data-chapter-link]")).map((a) => [a.dataset.chapterLink ?? "", a]),
    );
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const id = (entry.target as HTMLElement).dataset.chapter ?? "";
          if (entry.isIntersecting) visible.add(id);
          else visible.delete(id);
          const link = links.get(id);
          if (!link) continue;
          link.toggleAttribute("data-active", entry.isIntersecting);
          if (entry.isIntersecting) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        }
        index?.toggleAttribute("data-visible", visible.size > 0);
      },
      { rootMargin: "-50% 0px -50% 0px" },
    );
    root.querySelectorAll("[data-chapter]").forEach((el) => observer.observe(el));
  }
</script>

<style>
  .chapters {
    scroll-margin-top: var(--header-height);
  }

  /* Index */
  .index {
    display: none;
  }
  @media (min-width: 72rem) {
    .index {
      position: fixed;
      top: 50%;
      inset-inline-end: 1.5rem;
      z-index: 40;
      display: block;
      padding: 0.75rem 0.5rem;
      border-radius: 0.75rem;
      background: var(--color-glass);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      box-shadow:
        0 0 0 1px rgb(10 10 10 / 0.06),
        0 8px 24px rgb(10 10 10 / 0.08);
      opacity: 0;
      visibility: hidden;
      transform: translate(calc(8px * var(--dir)), -50%);
      transition:
        opacity 0.25s var(--ease-out),
        transform 0.25s var(--ease-out),
        visibility 0s linear 0.25s;
    }
    .index[data-visible] {
      opacity: 1;
      visibility: visible;
      transform: translate(0, -50%);
      transition:
        opacity 0.25s var(--ease-out),
        transform 0.25s var(--ease-out),
        visibility 0s;
    }
  }
  .index ol {
    display: grid;
    gap: 0.125rem;
  }
  .index a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--color-muted);
    font-size: 0.75rem;
  }
  :global(html[dir="rtl"]) .index a {
    font-size: var(--text-small);
  }
  .index a:hover,
  .index a[data-active] {
    color: var(--color-ink);
  }
  .ix-num {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }
  .index a::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 50%;
    width: 2px;
    height: 1rem;
    border-radius: 2px;
    background: var(--color-gold-ink);
    transform: translateY(-50%) scaleY(0);
    transition: transform 0.2s var(--ease-out);
  }
  .index a[data-active]::before {
    transform: translateY(-50%) scaleY(1);
  }

  /* Chapter */
  .chapter {
    position: relative;
    isolation: isolate;
    display: grid;
    border-top: var(--border-hairline);
    overflow: hidden;
    scroll-margin-top: var(--header-height);
  }
  .chapter-media {
    /* The unveil opens from the panel's inner edge, which flips in Arabic. */
    --unveil-l: 14%;
    --unveil-r: 0%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  :global(html[dir="rtl"]) .chapter-media {
    --unveil-l: 0%;
    --unveil-r: 14%;
  }
  .chapter-in {
    padding-block: 2.5rem 4.5rem;
  }
  .chapter-body {
    display: grid;
    justify-items: start;
    max-width: 30rem;
  }
  .chapter-meta {
    display: flex;
    gap: 1.25rem;
    font-size: var(--text-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold-ink);
  }
  :global(html[dir="rtl"]) .chapter-meta {
    font-size: var(--text-small);
    font-weight: var(--font-weight-bold);
  }
  .chapter-meta span + span {
    color: var(--color-muted);
  }
  .chapter-logo {
    width: auto;
    height: 3.25rem;
    max-width: 12rem;
    margin-block: 2rem 1.75rem;
    object-fit: contain;
    object-position: left center;
  }
  :global(html[dir="rtl"]) .chapter-logo {
    object-position: right center;
  }
  .chapter-title {
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    line-height: 1.05;
  }
  :global(html[dir="rtl"]) .chapter-title {
    line-height: 1.3;
  }
  .chapter-tag {
    margin-top: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: var(--border-hairline);
    font-family: var(--font-display);
    font-style: var(--style-accent);
    font-size: 1.125rem;
    line-height: 1.45;
  }
  :global(html[dir="rtl"]) .chapter-tag {
    font-family: var(--font-body);
    line-height: 1.8;
  }
  .chapter-text {
    margin-top: 1.5rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  .chapter-points {
    display: grid;
    width: 100%;
    margin-top: 1.5rem;
  }
  .chapter-points li {
    padding-block: 0.7rem;
    border-top: var(--border-hairline);
    font-size: var(--text-small);
  }
  .chapter-cta {
    margin-top: 2rem;
  }
  @media (min-width: 64rem) {
    .chapter {
      align-items: center;
      min-height: 100svh;
    }
    /* A full-height photo panel bleeding off the far edge, clear of the text
       column at every width; logical insets mirror it in Arabic. */
    .chapter-media {
      position: absolute;
      inset-block: clamp(2rem, 6vh, 4rem);
      inset-inline-start: max(
        46%,
        calc(var(--gutter) + 31rem),
        calc((100% - var(--container-page)) / 2 + var(--gutter) + 31rem)
      );
      inset-inline-end: 0;
      z-index: -1;
      aspect-ratio: auto;
    }
    .chapter-in {
      padding-block: 7rem;
    }
    .chapter-body {
      max-width: 27rem;
    }
  }

  /* Scroll-driven reveals. Longhands only: the minifier breaks the shorthand
     with a timeline. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .chapter-media {
        animation-name: chapter-unveil;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
      }
      /* A reveal that settles, not parallax: motion stops once the chapter is in view. */
      .chapter-media :global(.photo-img) {
        animation-name: chapter-zoom;
        animation-timing-function: var(--ease-out);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
      }
      .chapter-body > * {
        animation-name: chapter-fade;
        animation-timing-function: var(--ease-out);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 5% entry 45%;
      }
    }
  }
  @keyframes chapter-unveil {
    from {
      clip-path: inset(6% var(--unveil-r) 6% var(--unveil-l));
    }
    to {
      clip-path: inset(0);
    }
  }
  @keyframes chapter-zoom {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes chapter-fade {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
