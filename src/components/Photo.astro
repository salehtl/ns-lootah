---
// An optimised photograph that fills the box its parent gives it (object-fit:
// cover), so size the parent and style the image via `.parent :global(.photo-img)`.
// - AVIF with a WebP fallback (Astro's default fallback for WebP sources is PNG,
//   which balloons photos), a width ladder capped at the source size, lazy by default.
// - The frame is filled with the photo's average colour, so a slow image shows a
//   calm block instead of a white hole. With `reveal`, a cover of that colour
//   wipes away once the image has decoded (see [data-reveal] in global.css and
//   the script in Base.astro). The image itself is never clipped.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { averageColour } from "../lib/average-colour";
import { PHOTO_FALLBACK, PHOTO_FORMATS, widthLadder } from "../lib/images";

interface Props {
  src: ImageMetadata;
  /** Layout width hint, e.g. "(min-width: 64rem) 50vw, 100vw". */
  sizes: string;
  /** Alt text in the page's language. Leave empty for purely atmospheric photos. */
  alt?: string;
  /** Override the default width ladder. */
  widths?: number[];
  quality?: number;
  /** CSS object-position for the crop. */
  position?: string;
  /** Above the fold: eager, high fetch priority, no reveal. */
  priority?: boolean;
  /** Wipe away a cover of the photo's average colour once it has loaded. */
  reveal?: boolean;
  class?: string;
}

const {
  src,
  sizes,
  alt = "",
  widths = widthLadder(src.width),
  quality,
  position = "center",
  priority = false,
  reveal = !priority,
  class: className,
} = Astro.props;
const fill = await averageColour(src);
---

<div class:list={["photo", className]} data-reveal={reveal ? "" : undefined} style={`background-color: ${fill}`}>
  <Picture
    src={src}
    alt={alt}
    formats={PHOTO_FORMATS}
    fallbackFormat={PHOTO_FALLBACK}
    widths={widths}
    sizes={sizes}
    quality={quality}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
    class="photo-img"
    style={`object-position: ${position}`}
  />
</div>

<style>
  .photo {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .photo :global(picture) {
    display: contents;
  }
  .photo :global(.photo-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
