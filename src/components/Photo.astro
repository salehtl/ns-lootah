---
/**
 * An optimised photo: AVIF with a WebP <img> fallback (Astro's default
 * fallback is PNG, which balloons photos), a responsive width ladder
 * capped at the source size, explicit dimensions, lazy by default.
 * The <img> fills its parent box (object-fit: cover), so size the wrapper.
 */
import { Picture } from 'astro:assets';
import type { Photo } from '../data/types';

interface Props {
  photo: Photo;
  /** Layout width hint, e.g. '(min-width: 64rem) 50vw, 100vw'. */
  sizes: string;
  /** Above-the-fold: eager + high fetch priority. */
  priority?: boolean;
  /** Purely atmospheric: empty alt so screen readers skip it. */
  decorative?: boolean;
}

const { photo, sizes, priority = false, decorative = false } = Astro.props;

const natural = photo.src.width;
const ladder = [480, 768, 1080, 1440, 1920].filter((w) => w < natural);
if (natural <= 1920) ladder.push(natural);
---

<Picture
  src={photo.src}
  alt={decorative ? '' : photo.alt}
  formats={['avif']}
  fallbackFormat="webp"
  widths={ladder}
  sizes={sizes}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  class="photo"
  pictureAttributes={{ class: 'photo-frame' }}
/>
