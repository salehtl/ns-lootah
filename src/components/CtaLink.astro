---
// The site's call to action: a link with a trailing arrow that mirrors in
// right-to-left pages. Links that leave the site open in a new tab and get an
// up-and-out arrow.
//  - outline (default): gold hairline box, fills dark gold on hover
//  - solid: black box, for the one primary action in a view
//  - text: underlined in gold, for inline "read more" links
//  - on-dark: outline variant for black surfaces
import { isExternal } from "../lib/links";

interface Props {
  href: string;
  variant?: "outline" | "solid" | "text" | "on-dark";
  /** Defaults to true for full URLs. */
  external?: boolean;
}

const { href, variant = "outline", external = isExternal(href) } = Astro.props;
const externalAttrs = external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<a class:list={["cta", variant]} href={href} {...externalAttrs}>
  <span><slot /></span>
  <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
    {external ? <path d="M5 11 11 5M6 5h5v5" /> : <path d="M3 8h10M9 4l4 4-4 4" />}
  </svg>
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.4rem;
    border: 1px solid var(--color-gold);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    letter-spacing: 0.08em;
    transition:
      background-color var(--transition-colour),
      border-color var(--transition-colour),
      color var(--transition-colour),
      transform var(--transition-press);
  }
  :global(html[dir="rtl"]) .cta {
    font-size: 0.9375rem;
    font-weight: var(--font-weight-bold);
  }
  .arrow {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    transform: scaleX(var(--dir));
    transition: transform var(--transition-nudge);
  }
  .cta:active {
    transform: scale(0.98);
  }
  .solid {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-bg);
  }
  .text {
    padding: 0 0 0.35rem;
    border: 0;
    border-bottom: 1px solid var(--color-gold);
  }
  .on-dark {
    color: var(--color-on-dark);
  }
  @media (hover: hover) and (pointer: fine) {
    .cta:hover {
      border-color: var(--color-gold-ink);
      background: var(--color-gold-ink);
      color: #fff;
    }
    .cta:hover .arrow {
      transform: translateX(calc(3px * var(--dir))) scaleX(var(--dir));
    }
    .text:hover {
      background: none;
      color: var(--color-gold-ink);
    }
    .on-dark:hover {
      border-color: var(--color-gold);
      background: var(--color-gold);
      color: var(--color-black);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta:active {
      transform: none;
    }
  }
</style>
