---
/**
 * Fixed site header. Frosted off-white with a hairline; where scroll-driven
 * animations are supported it starts transparent over the page's hero and
 * settles to frosted as you scroll. Every page opens with a hero that
 * reserves var(--header-height) for it.
 */
import type { Lang } from '../i18n/types';
import { t } from '../i18n/translations';
import { getLocalizedPath } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const strings = t(lang);
const home = getLocalizedPath('/', lang);

const navLinks = [
  { label: strings.nav.about, href: getLocalizedPath('/about', lang) },
  { label: strings.nav.companies, href: `${home}#companies` },
  { label: strings.nav.news, href: getLocalizedPath('/news', lang) },
  { label: strings.nav.careers, href: getLocalizedPath('/careers', lang) },
  { label: strings.nav.contact, href: getLocalizedPath('/contact', lang) },
];

const isCurrent = (href: string) => !href.includes('#') && currentPath.startsWith(href);
---

<header class="hdr" transition:name="site-header" transition:animate="none">
  <div class="hdr-in">
    <a class="brand" href={home} aria-label={`${strings.site.name} — ${strings.nav.home}`}>
      <img src="/images/logos/ns-lootah-group-horizontal-bronze.svg" width="317" height="100" alt="" />
    </a>

    <nav class="nav" aria-label={strings.nav.mainNavigation}>
      <ul class="nav-desk" role="list">
        {navLinks.map((l) => (
          <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li><LanguageSwitcher lang={lang} currentPath={currentPath} /></li>
      </ul>

      <details class="nav-mob">
        <summary aria-label={strings.nav.openMenu}>
          <svg class="i-open" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 7h16M3 15h16" /></svg>
          <svg class="i-close" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M5 5l12 12M17 5 5 17" /></svg>
        </summary>
        <ul role="list">
          {navLinks.map((l) => (
            <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
          <li class="mob-lang"><LanguageSwitcher lang={lang} currentPath={currentPath} /></li>
        </ul>
      </details>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 60;
    background: var(--color-glass);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-rule);
  }

  /* Transparent over the hero, frosted once the page moves. Longhands only:
     the CSS minifier breaks the animation shorthand with a timeline. */
  @supports (animation-timeline: scroll()) {
    .hdr {
      animation-name: hdr-solid;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
      animation-range: 0 40vh;
    }
  }

  .hdr-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--max-width);
    height: var(--header-height);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand img {
    width: auto;
    height: 2.4rem;
  }

  .nav-desk {
    display: none;
    align-items: center;
    gap: 2.25rem;
  }

  .nav a {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    transition: color 0.3s ease;
  }

  :global(html[dir='rtl']) .nav a {
    font-size: 0.9375rem;
  }

  .nav a:hover,
  .nav a[aria-current='page'],
  .nav :global(.lang-switcher:hover) {
    color: var(--color-gold-ink);
  }

  .nav-desk a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-underline-offset: 0.5em;
    text-decoration-thickness: 1px;
  }

  .nav-mob summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-inline-end: -0.6rem;
    list-style: none;
    cursor: pointer;
  }

  .nav-mob summary::-webkit-details-marker {
    display: none;
  }

  .nav-mob svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
  }

  .i-close,
  .nav-mob[open] .i-open {
    display: none;
  }

  .nav-mob[open] .i-close {
    display: block;
  }

  .nav-mob ul {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    display: grid;
    max-height: calc(100svh - var(--header-height));
    overflow-y: auto;
    padding: 0.5rem var(--gutter) 2rem;
    background: var(--color-page);
    border-bottom: 1px solid var(--color-rule);
  }

  .nav-mob li:not(.mob-lang) a {
    display: block;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0;
  }

  .mob-lang {
    padding-top: 1.5rem;
  }

  @media (min-width: 64rem) {
    .nav-desk {
      display: flex;
    }

    .nav-mob {
      display: none;
    }
  }

  @keyframes hdr-solid {
    from {
      background-color: rgba(245, 245, 244, 0);
      border-bottom-color: transparent;
      -webkit-backdrop-filter: blur(0);
      backdrop-filter: blur(0);
    }
    to {
      background-color: var(--color-glass);
      border-bottom-color: var(--color-rule);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
    }
  }
</style>
