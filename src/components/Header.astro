---
// Fixed site header. Frosted off-white with a hairline; where scroll-driven
// animations are supported it starts transparent over the page's hero and
// settles to frosted as the page scrolls. Every page opens with a hero that
// reserves var(--header-height) for it. On small screens the links move into a
// disclosure menu (no JavaScript).
import { locales, localizePath, useTranslations, type Locale } from "../i18n";
import { logo } from "../lib/media";

interface Props {
  locale: Locale;
  /** This page in the other languages, each linked by its own name ("العربية", "English"). */
  translations: { code: Locale; href: URL }[];
}

const { locale, translations } = Astro.props;
const t = useTranslations(locale);
const mark = logo("ns-lootah-group-horizontal-bronze");
const links = [
  { href: localizePath(locale, "/about/"), label: t.nav.about },
  { href: localizePath(locale, "/companies/"), label: t.nav.companies },
  { href: localizePath(locale, "/news/"), label: t.nav.news },
  { href: localizePath(locale, "/careers/"), label: t.nav.careers },
  { href: localizePath(locale, "/contact/"), label: t.nav.contact },
];
const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href) ? "page" : undefined);
---

<header class="hdr">
  <div class="hdr-in">
    <a class="brand" href={localizePath(locale)} aria-label={t.nav.home}>
      <img src={mark.src} width={mark.width} height={mark.height} alt="" />
    </a>

    <nav class="nav" aria-label={t.nav.label}>
      <ul class="nav-desk" role="list">
        {links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
        {
          translations.map(({ code, href }) => (
            <li>
              <a class="lang" href={href.pathname} lang={code} hreflang={code}>
                {locales[code].name}
              </a>
            </li>
          ))
        }
      </ul>

      <details class="nav-mob">
        <summary>
          <span class="visually-hidden">{t.nav.menu}</span>
          <svg class="i-open" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 7h16M3 15h16"></path></svg>
          <svg class="i-close" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M5 5l12 12M17 5 5 17"></path></svg>
        </summary>
        <ul role="list">
          {links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
          {
            translations.map(({ code, href }) => (
              <li class="mob-lang">
                <a class="lang" href={href.pathname} lang={code} hreflang={code}>
                  {locales[code].name}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 60;
    background: var(--color-glass);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: var(--border-hairline);
  }

  /* Transparent over the hero, frosted once the page moves. Longhands only:
     the CSS minifier folds animation-timeline into the shorthand, which
     browsers then drop. */
  @supports (animation-timeline: scroll()) {
    .hdr {
      animation-name: hdr-solid;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
      animation-range: 0 40vh;
    }
  }

  .hdr-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--container-page);
    height: var(--header-height);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand img {
    width: auto;
    height: 2.4rem;
  }

  .nav-desk {
    display: none;
    align-items: center;
    gap: 2.25rem;
  }

  .nav a {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }

  :global(html[dir="rtl"]) .nav a {
    font-size: 0.9375rem;
  }

  /* The language switch is named in its own language and set in its own face. */
  .nav .lang:lang(ar) {
    font-family: var(--font-arabic);
    font-size: 0.9375rem;
    letter-spacing: 0;
  }

  .nav .lang:lang(en) {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }

  .nav a:hover,
  .nav a[aria-current="page"] {
    color: var(--color-gold-ink);
  }

  .nav-desk a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-underline-offset: 0.5em;
    text-decoration-thickness: 1px;
  }

  .nav-mob summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-inline-end: -0.6rem;
    list-style: none;
    cursor: pointer;
  }

  .nav-mob summary::-webkit-details-marker {
    display: none;
  }

  .nav-mob svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
  }

  .i-close,
  .nav-mob[open] .i-open {
    display: none;
  }

  .nav-mob[open] .i-close {
    display: block;
  }

  .nav-mob ul {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    display: grid;
    max-height: calc(100svh - var(--header-height));
    overflow-y: auto;
    padding: 0.5rem var(--gutter) 2rem;
    background: var(--color-bg);
    border-bottom: var(--border-hairline);
  }

  .nav-mob[open] ul {
    transition:
      transform 0.3s var(--ease-out),
      opacity 0.3s var(--ease-out);
    @starting-style {
      transform: translateY(-0.5rem);
      opacity: 0;
    }
  }

  .nav-mob li:not(.mob-lang) a {
    display: block;
    padding: 0.85rem 0;
    border-bottom: var(--border-hairline);
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0;
  }

  .mob-lang {
    padding-top: 1.5rem;
  }

  @media (min-width: 64rem) {
    .nav-desk {
      display: flex;
    }

    .nav-mob {
      display: none;
    }
  }

  @keyframes hdr-solid {
    from {
      background-color: rgb(245 245 244 / 0);
      border-bottom-color: transparent;
      -webkit-backdrop-filter: blur(0);
      backdrop-filter: blur(0);
    }
    to {
      background-color: var(--color-glass);
      border-bottom-color: var(--color-rule);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
    }
  }
</style>
