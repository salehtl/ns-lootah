---
// The Group's companies as a ruled index linking to their pages, in order.
//  - rows:    number, logo, name and tagline, sector: the full portfolio list
//  - compact: a two- or three-column grid of name and sector, for secondary mentions
// Optional `direct` adds a company's own contact lines under its row, keyed by
// slug. Rows use the stretched-link pattern, so the whole row is clickable while
// any direct-contact links stay focusable on their own.
import type { Locale } from "../i18n";
import { getCompanies } from "../lib/companies";
import { logo } from "../lib/media";
import { telHref } from "../lib/links";

export interface DirectLine {
  phone?: string;
  email?: string;
  address?: string;
}

interface Props {
  locale: Locale;
  variant?: "rows" | "compact";
  /** Heading level for company names; set to match the section outline. */
  level?: "h2" | "h3" | "h4";
  /** Contact lines by company slug ("real-fresh"). */
  direct?: Record<string, DirectLine>;
  /** Screen-reader label for the contact lines. */
  directLabel?: string;
}

const { locale, variant = "rows", level = "h3", direct, directLabel } = Astro.props;
const Name = level;
const companies = (await getCompanies(locale)).map((c) => ({ ...c, mark: logo(c.data.logo) }));
---

<ol class:list={["ci", variant]} role="list">
  {
    companies.map((c, i) => {
      const line = direct?.[c.slug];
      return (
        <li data-enter style={`--i: ${i % 3}`}>
          <span class="ci-num" aria-hidden="true">
            {c.number}
          </span>
          {variant === "rows" && (
            <span class="ci-logo">
              <img src={c.mark.src} width={c.mark.width} height={c.mark.height} alt="" loading="lazy" />
            </span>
          )}
          <div class="ci-main">
            <Name class="ci-name">
              <a href={c.href}>{c.data.name}</a>
            </Name>
            {variant === "rows" && <p class="ci-tag">{c.data.tagline}</p>}
            {line && (
              <dl class="ci-direct">
                <dt class="visually-hidden">{directLabel}</dt>
                {line.phone && (
                  <dd>
                    <a href={telHref(line.phone)}>
                      <bdi dir="ltr">{line.phone}</bdi>
                    </a>
                  </dd>
                )}
                {line.email && (
                  <dd>
                    <a href={`mailto:${line.email}`}>{line.email}</a>
                  </dd>
                )}
                {line.address && <dd class="ci-addr">{line.address}</dd>}
              </dl>
            )}
          </div>
          <span class="ci-sector">{c.data.sector}</span>
          <svg class="ci-arrow" width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" />
          </svg>
        </li>
      );
    })
  }
</ol>

<style>
  .ci {
    border-bottom: var(--border-hairline);
  }
  .ci li {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem 1.25rem;
    padding-block: 1.5rem;
    border-top: var(--border-hairline);
  }
  /* Stretched link: the name's anchor covers the row. */
  .ci-name a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .ci-name a:focus-visible {
    outline: none;
  }
  .ci li:has(.ci-name a:focus-visible) {
    outline: 2px solid var(--color-gold-ink);
    outline-offset: 2px;
  }
  .ci-direct a {
    position: relative;
    z-index: 2;
  }
  .ci-num {
    align-self: start;
    padding-top: 0.45rem;
    font-size: var(--text-caption);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .ci-logo {
    display: none;
  }
  .ci-logo img {
    width: auto;
    height: 2.5rem;
    max-width: 8.5rem;
    object-fit: contain;
    object-position: left center;
  }
  :global(html[dir="rtl"]) .ci-logo img {
    object-position: right center;
  }
  .ci-main {
    display: grid;
    gap: 0.35rem;
  }
  .ci-name {
    font-size: clamp(1.375rem, 2.2vw, 1.875rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    transition: color var(--transition-colour);
  }
  :global(html[dir="rtl"]) .ci-name {
    line-height: 1.4;
  }
  .ci-tag {
    font-size: var(--text-small);
    color: var(--color-muted);
  }
  .ci-direct {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.5rem;
    font-size: var(--text-small);
    color: var(--color-muted);
  }
  .ci-direct a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }
  .ci-direct a:hover {
    color: var(--color-gold-ink);
  }
  .ci-sector {
    display: none;
    font-size: var(--text-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold-ink);
  }
  :global(html[dir="rtl"]) .ci-sector {
    font-size: var(--text-small);
    font-weight: var(--font-weight-bold);
    text-transform: none;
  }
  .ci-arrow {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    color: var(--color-gold);
    transform: scaleX(var(--dir));
    transition: transform var(--transition-nudge);
  }
  @media (hover: hover) and (pointer: fine) {
    .ci li:hover .ci-name {
      color: var(--color-gold-ink);
    }
    .ci li:hover .ci-arrow {
      transform: translateX(calc(4px * var(--dir))) scaleX(var(--dir));
    }
  }
  @media (min-width: 48rem) {
    .ci-sector {
      display: block;
    }
    .ci li {
      grid-template-columns: 2.5rem minmax(0, 1fr) 11rem auto;
    }
  }
  @media (min-width: 64rem) {
    .rows .ci-logo {
      display: block;
    }
    .rows li {
      grid-template-columns: 3rem 10rem minmax(0, 1fr) 12rem auto;
      gap: 0.5rem 2rem;
      padding-block: 1.75rem;
    }
  }

  /* compact */
  .compact {
    display: grid;
    border-bottom: 0;
  }
  .compact li {
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    padding-block: 1.1rem;
  }
  .compact .ci-name {
    font-size: clamp(1.125rem, 1.6vw, 1.3125rem);
  }
  .compact .ci-sector {
    display: block;
    grid-column: 2;
    grid-row: 2;
    margin-top: -0.15rem;
  }
  .compact .ci-arrow {
    grid-column: 3;
    grid-row: 1 / span 2;
  }
  @media (min-width: 48rem) {
    .compact {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }
  @media (min-width: 64rem) {
    .compact {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
