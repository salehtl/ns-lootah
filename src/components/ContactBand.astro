---
// Closing contact section: the profile's glass dome as a pale print, a large
// "Contact us" and the Group's telephone, email and office.
import { localizePath, useTranslations, type Locale } from "../i18n";
import { photo } from "../lib/media";
import { telHref, type AccentTitle } from "../lib/links";
import Photo from "./Photo.astro";

interface Props {
  locale: Locale;
  title?: AccentTitle;
  lede?: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const band = t.contactBand;
const title = Astro.props.title ?? { lead: band.title, accent: band.accent };
const lede = Astro.props.lede ?? band.lede;
---

<section class="contact" aria-labelledby="contact-band-title">
  <div class="contact-bg">
    <Photo src={photo("profile/dome")} sizes="100vw" />
  </div>
  <div class="wrap contact-in">
    <h2 id="contact-band-title" class="contact-title" data-enter>
      {title.lead} <span class="gi">{title.accent}</span>
    </h2>
    <p class="contact-lede" data-enter style="--i: 1">{lede}</p>
    <div class="contact-row" data-enter style="--i: 2">
      <a href={telHref(t.firm.phone)}>
        <span>{band.telephone}</span>
        <bdi dir="ltr">{t.firm.phone}</bdi>
      </a>
      <a href={`mailto:${t.firm.email}`}>
        <span>{band.email}</span>
        {t.firm.email}
      </a>
      <a href={localizePath(locale, "/contact/")}>
        <span>{band.office}</span>
        {t.firm.address}
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: min(52rem, 85svh);
    padding-block: 8rem 4rem;
    overflow: hidden;
  }
  .contact-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .contact-bg :global(.photo-img) {
    filter: grayscale(1);
  }
  .contact-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, var(--color-bg), transparent 30%, transparent 45%, var(--color-bg) 85%),
      linear-gradient(var(--color-wash), var(--color-wash));
  }
  .contact-title {
    font-size: clamp(3.25rem, 10vw, 8.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  :global(html[dir="rtl"]) .contact-title {
    line-height: 1.2;
  }
  .contact-lede {
    max-width: 40ch;
    margin-top: 1.5rem;
    font-size: var(--text-lede);
    color: var(--color-muted);
  }
  .contact-row {
    display: grid;
    margin-top: 3rem;
    border-top: var(--border-hairline);
  }
  .contact-row a {
    display: grid;
    gap: 0.25rem;
    padding-block: 1.25rem;
    border-bottom: var(--border-hairline);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
  }
  .contact-row a:hover {
    color: var(--color-gold-ink);
  }
  /* The left-to-right phone number keeps to the reading start edge in Arabic too. */
  .contact-row bdi {
    justify-self: start;
  }
  .contact-row span {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  :global(html[dir="rtl"]) .contact-row span {
    font-size: var(--text-small);
    text-transform: none;
  }
  @media (min-width: 64rem) {
    .contact-row {
      grid-template-columns: repeat(3, 1fr);
      gap: 0 2rem;
      border-top: 0;
    }
    .contact-row a {
      border-top: var(--border-hairline);
      border-bottom: 0;
    }
  }
</style>
