---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactPage from '../../components/contact/ContactPage.astro';
import { contact } from '../../data/pages/contact';
import { breadcrumbJsonLd } from '../../data/pages/seo';
import { t } from '../../i18n/translations';

const lang = 'ar' as const;
const currentPath = '/ar/contact';
const strings = t(lang);
const page = contact[lang];

const jsonLd = breadcrumbJsonLd([
  { name: strings.nav.home, path: '/ar/' },
  { name: strings.nav.contact, path: currentPath },
]);
---

<BaseLayout title={page.meta.title} description={page.meta.description} lang={lang} currentPath={currentPath} jsonLd={jsonLd}>
  <ContactPage lang={lang} />
</BaseLayout>
