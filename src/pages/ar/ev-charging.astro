---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompanyPage from '../../components/company/CompanyPage.astro';
import { companyRoute } from '../../components/company/seo';

const lang = 'ar' as const;
const id = 'ev' as const;
const { title, description, currentPath, jsonLd } = companyRoute(lang, id);
---

<BaseLayout title={title} description={description} lang={lang} currentPath={currentPath} jsonLd={jsonLd}>
  <CompanyPage lang={lang} id={id} />
</BaseLayout>
