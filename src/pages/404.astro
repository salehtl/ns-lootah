---
/**
 * 404 — one page for both languages (the server can't know which the
 * visitor wanted), English first with the Arabic alongside.
 */
import '../styles/global.css';
import { notFound } from '../data/pages/not-found';

const blocks = [
  { lang: 'en' as const, dir: 'ltr', copy: notFound.en },
  { lang: 'ar' as const, dir: 'rtl', copy: notFound.ar },
];
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f5f5f4" />
    <link rel="icon" type="image/svg+xml" href="/meta-media/favicon.svg" />
    <link rel="preload" href="/fonts/lora-variable.woff2" as="font" type="font/woff2" crossorigin />
    <title>Page not found — N S Lootah Group</title>
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a href="/en/" aria-label="N S Lootah Group — Home">
          <img src="/images/logos/ns-lootah-group-horizontal-bronze.svg" width="317" height="100" alt="" />
        </a>
      </div>
    </header>

    <main class="nf">
      <div class="wrap">
        <p class="code" aria-hidden="true">404</p>
        <div class="blocks">
          {blocks.map(({ lang, dir, copy }) => (
            <section class:list={['block', lang]} lang={lang} dir={dir} aria-labelledby={`nf-${lang}`}>
              {lang === 'en' ? <h1 id="nf-en">{copy.title}</h1> : <h2 id="nf-ar">{copy.title}</h2>}
              <p>{copy.text}</p>
              <nav aria-label={copy.linksLabel}>
                <ul role="list">
                  {copy.links.map((l) => (
                    <li>
                      <a href={l.path}>
                        <span>{l.label}</span>
                        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </section>
          ))}
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  .top {
    border-bottom: 1px solid var(--color-rule);
  }

  .top .wrap {
    display: flex;
    align-items: center;
    height: var(--header-height);
  }

  .top img {
    width: auto;
    height: 2.4rem;
  }

  .nf {
    flex: 1;
    padding-block: clamp(3.5rem, 9vw, 7rem) var(--section-space);
  }

  .code {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(5rem, 16vw, 12rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--color-gold);
  }

  .blocks {
    display: grid;
    gap: 3.5rem;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .block {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-rule-strong);
  }

  /* The Arabic block sits in an LTR document, so set its faces locally. */
  .ar {
    --font-display: var(--font-ar-display);
    --font-body: var(--font-ar-body);
    --weight-display: 700;
    --leading-display: 1.3;
    font-family: var(--font-body);
    line-height: 1.85;
  }

  .block h1,
  .block h2 {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(2.25rem, 4.6vw, 3.5rem);
    line-height: var(--leading-display);
    letter-spacing: -0.02em;
  }

  .ar h2 {
    letter-spacing: normal;
  }

  .block p {
    color: var(--color-muted);
  }

  .block ul {
    border-top: 1px solid var(--color-rule);
  }

  .block a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-display);
    font-size: 1.25rem;
    transition: color 0.3s ease;
  }

  .block a:hover {
    color: var(--color-gold-ink);
  }

  .block svg {
    flex: none;
    fill: none;
    stroke: var(--color-gold);
    stroke-width: 1.25;
    transition: transform 0.3s ease;
  }

  .ar svg {
    transform: scaleX(-1);
  }

  @media (hover: hover) and (pointer: fine) {
    .en a:hover svg {
      transform: translateX(3px);
    }

    .ar a:hover svg {
      transform: translateX(-3px) scaleX(-1);
    }
  }

  @media (min-width: 64rem) {
    .blocks {
      grid-template-columns: repeat(2, 1fr);
      gap: 5rem;
    }
  }
</style>
