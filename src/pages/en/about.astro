---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutPage from '../../components/about/AboutPage.astro';
import { about } from '../../data/pages/about';
import { breadcrumbJsonLd } from '../../data/pages/seo';
import { t } from '../../i18n/translations';

const lang = 'en' as const;
const currentPath = '/en/about';
const strings = t(lang);
const page = about[lang];

const jsonLd = breadcrumbJsonLd([
  { name: strings.nav.home, path: '/en/' },
  { name: strings.nav.about, path: currentPath },
]);
---

<BaseLayout title={page.meta.title} description={page.meta.description} lang={lang} currentPath={currentPath} jsonLd={jsonLd}>
  <AboutPage lang={lang} />
</BaseLayout>
