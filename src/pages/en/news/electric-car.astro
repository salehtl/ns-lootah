---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NewsArticle from '../../../components/news/NewsArticle.astro';
import { getArticle } from '../../../data/pages/news';
import { breadcrumbJsonLd } from '../../../data/pages/seo';
import { t } from '../../../i18n/translations';

const lang = 'en' as const;
const slug = 'electric-car';
const currentPath = `/en/news/${slug}`;
const strings = t(lang);
const article = getArticle(lang, slug);

const jsonLd = breadcrumbJsonLd([
  { name: strings.nav.home, path: '/en/' },
  { name: strings.nav.news, path: '/en/news' },
  { name: article.title, path: currentPath },
]);
---

<BaseLayout title={article.meta.title} description={article.meta.description} lang={lang} currentPath={currentPath} jsonLd={jsonLd}>
  <NewsArticle lang={lang} slug={slug} />
</BaseLayout>
