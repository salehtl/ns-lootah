---
// A news article: long-form measure, pull quotes, the press photograph
// alongside. The body is the Markdown in src/content/news/<locale>/; a >
// blockquote whose last line is "— Name, Role" is set as a pull quote.
import { getImage } from "astro:assets";
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Photo from "../components/Photo.astro";
import { localizePath, useTranslations, type Locale } from "../i18n";
import type { Article } from "../lib/news";
import { logo, photo } from "../lib/media";
import { breadcrumbJsonLd } from "../lib/links";

interface Props {
  locale: Locale;
  article: Article;
}

const { locale, article } = Astro.props;
const t = useTranslations(locale);
const d = article.data;
const { Content } = await render(article);
// The title's last words in gold, when the article names them.
const title =
  d.accent && d.title.endsWith(d.accent)
    ? { lead: d.title.slice(0, -d.accent.length).trimEnd(), accent: d.accent }
    : { lead: d.title, accent: "" };

const home = localizePath(locale);
const newsHref = localizePath(locale, "/news/");
const crumbs = [
  { label: t.nav.homeCrumb, href: home },
  { label: t.nav.news, href: newsHref },
  { label: d.title },
];

// Structured data: the article itself and its breadcrumb trail.
const abs = (path: string) => new URL(path, Astro.site).href;
const images = await Promise.all(
  [d.card, d.photo].map((key) => getImage({ src: photo(key), format: "jpeg", width: Math.min(1200, photo(key).width) })),
);
const { "@context": _context, ...trail } = breadcrumbJsonLd(Astro.site, [
  { name: t.nav.homeCrumb, path: home },
  { name: t.nav.news, path: newsHref },
  { name: d.title, path: article.href },
]);
const group = { "@type": "Organization", name: t.site, url: abs(home) };
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NewsArticle",
      headline: d.title,
      description: d.description,
      inLanguage: locale,
      mainEntityOfPage: abs(article.href),
      image: images.map((img) => abs(img.src)),
      ...(d.date ? { datePublished: d.date.toISOString().slice(0, 10) } : {}),
      author: group,
      publisher: { ...group, logo: { "@type": "ImageObject", url: abs(logo("ns-lootah-group-bronze").src) } },
    },
    trail,
  ],
};
---

<Base title={d.title} description={d.description} lang={locale} jsonLd={jsonLd}>
  <article class="article" aria-labelledby="page-title">
    <PageHero
      label={d.topic}
      title={title}
      size="compact"
      lede={d.summary}
      crumbs={crumbs}
      crumbsLabel={t.a11y.breadcrumb}
    />

    <div class="wrap article-grid">
      <figure class="article-photo">
        <div class="photo-box">
          <Photo src={photo(d.photo)} alt={d.photoAlt} sizes="(min-width: 64rem) 22rem, 90vw" />
        </div>
        {d.caption && <figcaption>{d.caption}</figcaption>}
      </figure>

      <div class="article-body">
        {d.date && <time datetime={d.date.toISOString().slice(0, 10)}>{t.date(d.date)}</time>}
        <Content />

        <a class="back" href={newsHref}>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M13 8H3M7 4 3 8l4 4"></path>
          </svg>
          {t.news.backToNews}
        </a>
      </div>
    </div>
  </article>
</Base>

<style>
  .article-grid {
    display: grid;
    gap: 3rem;
    padding-block: clamp(3rem, 7vw, 5rem) var(--section-space);
  }
  .article-photo {
    max-width: 22rem;
  }
  .photo-box {
    aspect-ratio: 600 / 798;
    overflow: hidden;
  }
  .article-photo figcaption {
    margin-top: 0.75rem;
    font-size: var(--text-caption);
    color: var(--color-muted);
  }
  .article-body {
    display: grid;
    gap: 1.5rem;
    max-width: 65ch;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text);
  }
  :global(html[dir="rtl"]) .article-body {
    font-size: 1.125rem;
    line-height: 1.95;
  }
  time {
    font-size: var(--text-caption);
    color: var(--color-muted);
  }
  .article-body > :global(p:first-of-type::first-line) {
    color: var(--color-ink);
  }

  /* Subheadings, from ## in the Markdown. */
  .article-body :global(h2) {
    margin-top: 1.5rem;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  :global(html[dir="rtl"]) .article-body :global(h2) {
    line-height: 1.45;
  }

  /* Pull quotes, from > blockquotes in the Markdown. The last paragraph, when
     there is more than one, is the attribution ("— Name, Role"). */
  .article-body :global(blockquote) {
    display: grid;
    gap: 1rem;
    margin-block: 1.5rem;
    padding-inline-start: 1.5rem;
    border-inline-start: 2px solid var(--color-gold);
  }
  .article-body :global(blockquote p) {
    font-family: var(--font-display);
    font-style: var(--style-accent);
    font-size: clamp(1.3125rem, 2vw, 1.625rem);
    line-height: 1.45;
    color: var(--color-ink);
  }
  :global(html[dir="rtl"]) .article-body :global(blockquote p) {
    line-height: 1.75;
  }
  .article-body :global(blockquote p:last-child:not(:first-child)) {
    font-family: var(--font-body);
    font-style: normal;
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-gold-ink);
  }

  .back {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.6rem;
    margin-top: 2rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-gold);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    letter-spacing: 0.08em;
    color: var(--color-ink);
  }
  :global(html[dir="rtl"]) .back {
    font-size: 0.9375rem;
    font-weight: var(--font-weight-bold);
  }
  .back svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    transform: scaleX(var(--dir));
    transition: transform var(--transition-nudge);
  }
  .back:hover {
    color: var(--color-gold-ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .back:hover svg {
      transform: translateX(calc(-3px * var(--dir))) scaleX(var(--dir));
    }
  }
  @media (min-width: 64rem) {
    .article-grid {
      grid-template-columns: 22rem minmax(0, 1fr);
      gap: 6rem;
      align-items: start;
    }
    .article-photo {
      position: sticky;
      top: calc(var(--header-height) + 2rem);
    }
  }
</style>
