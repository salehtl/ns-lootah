---
import type { Lang } from '../i18n/types';
import { getDir } from '../i18n/utils';
import SEOHead from '../components/SEOHead.astro';
import SkipToContent from '../components/SkipToContent.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/translations';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  currentPath: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, lang, currentPath, ogImage, jsonLd } = Astro.props;
const dir = getDir(lang);
const strings = t(lang);

// Above-the-fold faces: the display face and the body face for this language.
const preloads =
  lang === 'ar'
    ? ['/fonts/almarai-arabic-700.woff2', '/fonts/ibm-plex-sans-arabic-regular.woff2']
    : ['/fonts/lora-variable.woff2', '/fonts/dm-sans-regular.woff2'];
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f5f4" />
    <link rel="icon" type="image/svg+xml" href="/meta-media/favicon.svg" />
    {preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <ClientRouter />

    <SEOHead
      title={title}
      description={description}
      lang={lang}
      currentPath={currentPath}
      ogImage={ogImage}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <SkipToContent label={strings.a11y.skipToContent} />
    <Header lang={lang} currentPath={currentPath} />
    <main id="main-content" tabindex="-1" transition:animate="fade">
      <slot />
    </main>
    <Footer lang={lang} currentPath={currentPath} />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
