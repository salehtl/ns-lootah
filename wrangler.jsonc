// Cloudflare Workers deployment. Every page is prerendered and served as static
// assets; a small Worker (worker/index.ts) only handles POST /api/contact and
// the CMS sign-in at /api/cms/*.
// Workers Builds: build command `bun run build`, deploy command `bunx wrangler deploy`,
// production branch master, build variable BUN_VERSION pinned (see README, "Deploy").
// The contact recipient is the CONTACT_TO secret (`wrangler secret put CONTACT_TO`),
// so it is not stored in the repo. Set it after the first deploy that includes the Worker.
{
  "name": "nslootah",
  "main": "./worker/index.ts",
  // A little in the past: local workerd rejects dates newer than itself.
  "compatibility_date": "2026-10-30",
  "upload_source_maps": true,
  // The <name>.<account>.workers.dev URL. Turn off once the custom domain is live.
  "workers_dev": true,
  // No public per-version preview links.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /api/* runs the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Email Sending. CONTACT_FROM must be on a domain onboarded to Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  // At most 5 contact submissions per minute per IP, per Cloudflare location.
  "ratelimits": [
    {
      "name": "CONTACT_LIMIT",
      "namespace_id": "4201",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "SITE_NAME": "N S Lootah Group",
    "CONTACT_FROM": "website@nslootah.com",
    // CMS sign-in (worker/cms-auth.ts). /admin and /api/cms sit behind a Cloudflare
    // Access application (email one-time code); the Worker checks Access's signed
    // token against these before handing the CMS its GitHub token, the
    // CMS_GITHUB_TOKEN secret. Fill both in when the Access app exists.
    "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com",
    "ACCESS_AUD": "<access-application-aud-tag>"
  },
  "observability": { "enabled": true }
}
