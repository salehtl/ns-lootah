// Cloudflare Workers deployment. Every page is prerendered and served as static
// assets; a small Worker (worker/index.ts) only handles POST /api/contact and
// the CMS sign-in at /api/cms/*.
// Workers Builds: every push to master, build command `bun run build`, deploy command
// `bunx wrangler deploy`, build variable BUN_VERSION pinned (see README, "Deploy").
// Served at nslootah.com, a Custom Domain set on the Worker in the dashboard, not here.
// The contact recipient is the CONTACT_TO secret, so it is not stored in the repo.
{
  "name": "nslootah",
  "main": "./worker/index.ts",
  // A little in the past: local workerd rejects dates newer than itself.
  "compatibility_date": "2026-10-30",
  "upload_source_maps": true,
  // No <name>.<account>.workers.dev URL: the site is served on its Custom Domain only.
  "workers_dev": false,
  // No public per-version preview links.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /api/* runs the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Email Sending. CONTACT_FROM is on nslootah.com, onboarded to Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  // At most 5 contact submissions per minute per IP, per Cloudflare location. The
  // namespace is per account: other sites on this account must use their own id.
  "ratelimits": [
    {
      "name": "CONTACT_LIMIT",
      "namespace_id": "4202",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "SITE_NAME": "N S Lootah Group",
    "CONTACT_FROM": "website@nslootah.com",
    // CMS sign-in (worker/cms-auth.ts). /admin and /api/cms sit behind the Cloudflare
    // Access application "N S Lootah Group site editor" (email one-time code); the Worker
    // checks Access's signed token against these before handing the CMS its GitHub
    // token, the CMS_GITHUB_TOKEN secret. The app covers nslootah.com/admin and /api/cms.
    "ACCESS_TEAM_DOMAIN": "grey-pigeon.cloudflareaccess.com",
    "ACCESS_AUD": "7bef8bd40e3ede2e5c8457fefa83880fc5e68fd5439dd314337c63730f30376d"
  },
  "observability": { "enabled": true }
}
